+    #[test]
+    fn answer_echoes_stereo_only_on_the_sections_the_offer_marks() {
+        let out = PeerTransport::munge_stereo_from_offer(STEREO_OFFER, MONO_ANSWER);
+        assert_eq!(out.matches("stereo=1").count(), 1);
+        // The section of mid 2, and not the one of mid 0 with the same payload type.
+        let (first, last) = out.split_once("a=mid:2").unwrap();
+        assert!(!first.contains("stereo=1"));
+        assert!(last.contains("a=fmtp:111 minptime=10;useinbandfec=1;stereo=1\r\n"));
+        // Nothing else moved: taking the addition out gives the answer back.
+        assert_eq!(out.replace(";stereo=1", ""), MONO_ANSWER);
+        // The RED line names the Opus payload type but is not one.
+        assert!(out.contains("a=fmtp:63 111/111\r\n"));
+    }
+
