+        // `stereo=0` and `sprop-stereo=1` are not a stereo sender.
+        let not_stereo = STEREO_OFFER.replace(";stereo=1", ";stereo=0;sprop-stereo=1");
+        assert_eq!(PeerTransport::munge_stereo_from_offer(&not_stereo, MONO_ANSWER), MONO_ANSWER);
+    }
+
+    #[test]
+    fn answer_stereo_munging_is_idempotent_and_keeps_line_endings() {
+        let once = PeerTransport::munge_stereo_from_offer(STEREO_OFFER, MONO_ANSWER);
+        assert_eq!(PeerTransport::munge_stereo_from_offer(STEREO_OFFER, &once), once);
+        let lf_answer = MONO_ANSWER.replace("\r\n", "\n");
+        let out = PeerTransport::munge_stereo_from_offer(STEREO_OFFER, &lf_answer);
+        assert!(!out.contains('\r'));
+        assert_eq!(out.replace(";stereo=1", ""), lf_answer);
+    }
