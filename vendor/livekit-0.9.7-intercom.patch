+    /// InterCom: `answer` with `stereo=1` added to the Opus fmtp lines of every
+    /// audio section whose counterpart in `offer` (same `a=mid`) has it. An
+    /// answer with nothing to add comes back unchanged, byte for byte.
+    fn munge_stereo_from_offer(offer: &str, answer: &str) -> String {
+        /// One `m=` section: its mid and the fmtp lines of its Opus payload types.
+        struct Section<'a> {
+            is_audio: bool,
+            mid: Option<&'a str>,
+            opus_pts: Vec<&'a str>,
+        }
+
+        fn sections(sdp: &str) -> Vec<Section<'_>> {
+            let mut out: Vec<Section<'_>> = Vec::new();
+            for line in sdp.lines() {
+                let line = line.trim_end();
+                if let Some(media) = line.strip_prefix("m=") {
+                    out.push(Section {
+                        is_audio: media.starts_with("audio "),
+                        mid: None,
+                        opus_pts: Vec::new(),
+                    });
+                    continue;
+                }
+                let Some(section) = out.last_mut() else { continue };
+                if let Some(mid) = line.strip_prefix("a=mid:") {
+                    section.mid = Some(mid.trim());
+                } else if let Some(rest) = line.strip_prefix("a=rtpmap:") {
+                    let mut it = rest.split_whitespace();
+                    let pt = it.next().unwrap_or("");
+                    let codec = it.next().unwrap_or("");
+                    if codec.to_ascii_lowercase().starts_with("opus/48000") && !pt.is_empty() {
+                        section.opus_pts.push(pt);
+                    }
+                }
+            }
+            out
+        }
+
+        fn is_opus_fmtp(line: &str, pts: &[&str]) -> bool {
+            line.strip_prefix("a=fmtp:")
+                .and_then(|rest| rest.split_whitespace().next())
+                .is_some_and(|pt| pts.contains(&pt))
+        }
+
+        fn says_stereo(line: &str) -> bool {
+            line.split_once(' ').is_some_and(|(_, params)| {
+                params.split(';').any(|param| param.trim() == "stereo=1")
+            })
+        }
+
+        // The mids the offer sends in stereo.
+        let offer_sections = sections(offer);
+        let mut stereo_mids: Vec<&str> = Vec::new();
+        let mut index: Option<usize> = None;
+        for line in offer.lines() {
+            let line = line.trim_end();
+            if line.starts_with("m=") {
+                index = Some(index.map_or(0, |i| i + 1));
+                continue;
+            }
+            let Some(section) = index.and_then(|i| offer_sections.get(i)) else { continue };
+            if section.is_audio && is_opus_fmtp(line, &section.opus_pts) && says_stereo(line) {
+                if let Some(mid) = section.mid {
+                    if !stereo_mids.contains(&mid) {
+                        stereo_mids.push(mid);
+                    }
+                }
+            }
+        }
+        if stereo_mids.is_empty() {
+            return answer.to_string();
+        }
+
+        let answer_sections = sections(answer);
+        let uses_crlf = answer.contains("\r\n");
+        let eol = if uses_crlf { "\r\n" } else { "\n" };
+        let lines: Vec<&str> =
+            if uses_crlf { answer.split("\r\n").collect() } else { answer.split('\n').collect() };
+        let mut out: Vec<String> = Vec::with_capacity(lines.len());
+        let mut index: Option<usize> = None;
+        for line in lines {
+            if line.starts_with("m=") {
+                index = Some(index.map_or(0, |i| i + 1));
+            }
+            let wanted = index.and_then(|i| answer_sections.get(i)).is_some_and(|section| {
+                section.is_audio
+                    && section.mid.is_some_and(|mid| stereo_mids.contains(&mid))
+                    && is_opus_fmtp(line, &section.opus_pts)
+            });
+            if wanted && !line.contains("stereo=") {
+                out.push(format!("{line};stereo=1"));
+            } else {
+                out.push(line.to_string());
+            }
+        }
+        out.join(eol)
+    }
